<Window x:Class="WPFApplication24082026.DetailEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFApplication24082026"
        mc:Ignorable="d" ResizeMode="NoResize"
        Title="Детализация строки таблицы Сотрудники" Height="400" Width="400">
    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Label Grid.Row="0" FontWeight="Bold" Target="{Binding ElementName=NameDetail}">Наименование</Label>
        <TextBox Grid.Row="1" Name="NameTextDetail" MinWidth="250">Наименование</TextBox>
        <Label Grid.Row="2" FontWeight="Bold" Target="{Binding ElementName=SpecificationDetail}">Спецификация</Label>
        <TextBox Grid.Row="3" Name="SpecificationDetail" MinWidth="250">Спецификация</TextBox>
        <Label Grid.Row="4" FontWeight="Bold" Target="{Binding ElementName=CategoryDetail}">Категория</Label>
        <TextBox Grid.Row="5" Name="CategoryDetail" MinWidth="250">Категория</TextBox>
        <Label Grid.Row="6" FontWeight="Bold" Target="{Binding ElementName=PriceDetail}">Цена:</Label>
        <TextBox Grid.Row="7" Name="PriceDetail" MinWidth="250">Цена</TextBox>
        <Label Grid.Row="8" FontWeight="Bold" Target="{Binding ElementName=DescriptionDetail}">Описание</Label>
        <TextBox Grid.Row="9" Name="DescriptionDetail" MinWidth="250">Описание</TextBox>
        <Label Grid.Row="10" FontWeight="Bold" Target="{Binding ElementName=AddressDetail}">Адрес</Label>
        <TextBox Grid.Row="11" Name="AddressDetail" MinWidth="250">Адрес</TextBox>        
    </Grid>
</Window>
